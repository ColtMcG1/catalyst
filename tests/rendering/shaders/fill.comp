// Compute stage used by the rendering tests: writes `index * multiplier` into every element of a storage buffer.
// Binding model (see catalyst/rendering/command.hpp): storage buffers live in set 1, `set_storage_buffer(cl, 0, ...)`
// binds to (set = 1, binding = 0); `push_constants` feeds the push-constant block.
#version 450

layout(local_size_x = 64) in;

layout(set = 1, binding = 0) buffer Output
{
    uint data[];
} output_buffer;

layout(push_constant) uniform Constants
{
    uint multiplier;
} constants;

void main()
{
    const uint i = gl_GlobalInvocationID.x;
    if (i < output_buffer.data.length())
        output_buffer.data[i] = i * constants.multiplier;
}
